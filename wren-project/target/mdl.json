    }
  ],
  "relationships": [
    {
      "name": "cc_snapshots_team_members",
      "models": [
        "cc_snapshots",
        "team_members"
      ],
      "joinType": "many_to_one",
      "condition": "cc_snapshots.team_member_id = team_members.id"
    },
    {
      "name": "mr_snapshots_team_members",
      "models": [
        "mr_snapshots",
        "team_members"
      ],
      "joinType": "many_to_one",
      "condition": "mr_snapshots.team_member_id = team_members.id"
