{
  "catalog": "wren",
  "schema": "public",
  "models": [
    {
      "name": "cc_snapshots",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "cc_snapshots"
      },
      "properties": {
        "description": "Monthly Claude Code adoption per team member: lines of AI-generated code accepted. One row per member per month."
      },
      "columns": [
        {
          "name": "id",
          "type": "UUID",
          "notNull": true
        },
        {
          "name": "team_member_id",
          "type": "UUID",
          "notNull": true,
          "properties": {
            "description": "The member (team_members.id)."
          }
        },
        {
          "name": "month",
          "type": "DATE",
          "notNull": true,
          "properties": {
            "description": "First day of the month."
          }
        },
        {
          "name": "lines_adopted",
          "type": "INT",
          "notNull": true,
          "properties": {
            "description": "Lines of Claude Code output the member accepted that month."
          }
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        }
      ],
      "primaryKey": "id"
    },
    {
      "name": "gitlab_groups",
