      },
      "columns": [
        {
          "name": "id",
          "type": "UUID",
          "notNull": true
        },
        {
          "name": "gitlab_group_id",
          "type": "INT",
          "notNull": true,
          "properties": {
            "description": "Numeric GitLab group id."
          }
        },
        {
          "name": "name",
          "type": "TEXT",
          "notNull": true
        },
        {
          "name": "path",
          "type": "TEXT",
          "notNull": true,
          "properties": {
            "description": "GitLab group path."
          }
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        }
      ],
      "primaryKey": "id"
    },
    {
      "name": "groups",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "groups"
      },
      "properties": {
        "description": "Engineering teams (Backend, Frontend, DevOps, Data, Quality, Product, Engineering, External). One row per team."
      },
      "columns": [
        {
          "name": "id",
          "type": "UUID",
          "notNull": true
        },
        {
          "name": "name",
          "type": "TEXT",
          "notNull": true,
          "properties": {
            "description": "Team name."
          }
        },
        {
          "name": "color",
          "type": "TEXT",
          "notNull": true,
          "properties": {
            "description": "Hex colour used by the dashboard."
          }
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        }
      ],
      "primaryKey": "id"
    },
    {
      "name": "mr_snapshots",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "mr_snapshots"
      },
      "properties": {
        "description": "Monthly GitLab merge-request metrics per team member. One row per member per month; month is the first day of the month."
      },
      "columns": [
        {
          "name": "id",
          "type": "UUID",
          "notNull": true
        },
        {
          "name": "team_member_id",
          "type": "UUID",
          "notNull": true,
          "properties": {
            "description": "The member these metrics belong to (team_members.id)."
          }
        },
        {
          "name": "month",
          "type": "DATE",
          "notNull": true,
          "properties": {
            "description": "First day of the month the metrics cover."
          }
        },
        {
          "name": "mrs_created",
          "type": "INT",
          "notNull": true,
          "properties": {
            "description": "Merge requests the member opened that month."
          }
        },
        {
          "name": "mrs_merged",
          "type": "INT",
          "notNull": true,
          "properties": {
            "description": "Merge requests by the member merged that month."
          }
        },
        {
          "name": "approvals_given",
          "type": "INT",
          "notNull": true,
          "properties": {
            "description": "Approvals/reviews the member gave to others that month."
          }
        },
        {
          "name": "avg_time_to_merge_hours",
          "type": "DECIMAL(8, 2)",
          "properties": {
            "description": "Mean hours from MR open to merge. Not populated yet (NULL everywhere)."
          }
        },
        {
          "name": "avg_review_turnaround_hours",
          "type": "DECIMAL(8, 2)",
          "properties": {
            "description": "Mean hours to respond to review requests. Not populated yet (NULL everywhere)."
          }
        },
        {
          "name": "synced_at",
          "type": "TIMESTAMPTZ",
          "notNull": true,
          "properties": {
            "description": "When the row was last pulled from GitLab."
          }
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        }
      ],
      "primaryKey": "id"
    },
    {
      "name": "team_members",
