      },
      "columns": [
        {
          "name": "id",
          "type": "UUID",
          "notNull": true
        },
        {
          "name": "full_name",
          "type": "TEXT",
          "notNull": true,
          "properties": {
            "description": "Display name."
          }
        },
        {
          "name": "gitlab_email",
          "type": "TEXT",
          "notNull": true,
          "properties": {
            "description": "GitLab identity used to attribute merge requests."
          }
        },
        {
          "name": "group_id",
          "type": "UUID",
          "notNull": true,
          "properties": {
            "description": "Team the member belongs to (groups.id)."
          }
        },
        {
          "name": "employee_type",
          "type": "TEXT",
          "notNull": true,
          "properties": {
            "description": "Employment type, e.g. full-time."
          }
        },
        {
          "name": "contract_start_date",
          "type": "DATE",
          "properties": {
            "description": "Contract start; NULL if unknown."
          }
        },
        {
          "name": "contract_end_date",
          "type": "DATE",
          "properties": {
            "description": "Contract end; set only for fixed-term contracts."
          }
        },
        {
          "name": "deleted_at",
          "type": "TIMESTAMPTZ",
          "properties": {
            "description": "Soft delete timestamp. Active members have NULL."
          }
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "notNull": true
        },
        {
          "name": "gitlab_username",
          "type": "TEXT",
          "properties": {
            "description": "GitLab handle."
          }
        }
      ],
      "primaryKey": "id"
    },
    {
