# Copy to .env and fill in. .env is gitignored; keep a copy in Vaultwarden (vault.kamisamanosumopod.my.id).
# SSH fallback only; normal access is key-based via `ssh terracotta`.
terracotta_ip=103.92.215.36
terracotta_username=root
terracotta_password=
# Supabase "sidora" (project wmkkjlxxiphgcynfgsjn). Password: Supabase dashboard -> Project Settings -> Database.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=db.wmkkjlxxiphgcynfgsjn.supabase.co
SUPABASE_DB_USER=postgres
# Bearer token Caddy enforces in front of the MCP server. Generate: openssl rand -hex 32
WREN_MCP_TOKEN=

# LibreChat (librechat/deploy.sh). Generate with: openssl rand -hex 32 (CREDS_IV: -hex 16). Never rotate CREDS_*.
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_ALLOW_REGISTRATION=true   # set false after creating your account, then redeploy
